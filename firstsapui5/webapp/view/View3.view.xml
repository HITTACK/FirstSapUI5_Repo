<mvc:View controllerName="com.demo.firstsapui5.controller.View3"
    xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns="sap.m" xmlns:l="sap.ui.layout">
    <Page id="newPage" title="newView">
        <content>
            <Panel
                headerText="Employee Details"
                expandable="true"
                expanded="true"
            >
                <l:Grid
                    defaultSpan="L6 M6"
                    vSpacing="1"
                >
                    <l:content>
                        <Label
                            text="Employee ID"
                            class="sapUiTinyMarginTop"
                        />
                        <Input />
                        <Label
                            text="Employee Name"
                            class="sapUiTinyMarginTop"
                        />
                        <Input />
                        <Label
                            text="Employee Designation"
                            class="sapUiTinyMarginTop"
                        />
                        <Input />
                        <Label
                            text="Employee Skill"
                            class="sapUiTinyMarginTop"
                        />
                        <Input />
                        <Label
                            text="Employee EmailId"
                            class="sapUiTinyMarginTop"
                        />
                        <Input />
                        <Label
                            text="Employee Phone no."
                            class="sapUiTinyMarginTop"
                        />
                        <Input />
                    </l:content>
                </l:Grid>
            </Panel>
            <Panel
                headerText="Pernal Details"
                expandable="true"
            >
                <l:Grid
                    defaultSpan="L3 M3"
                    vSpacing="1"
                >
                    <l:content>
                        <Label text="Employee ID" />
                        <Input />
                        <Label text="Employee Name" />
                        <Input />
                        <Label text="Family members" />
                        <Input />
                        <Label text="Spouse Name" />
                        <Input />
                        <Label text="Spouse EmailId" />
                        <Input />
                        <Label text="Spouse Phone no." />
                        <Input />
                    </l:content>
                </l:Grid>
            </Panel>
            <Panel
                headerText="Office Details"
                expandable="true"
            >
                <l:Grid
                    defaultSpan="L2 M2"
                    vSpacing="1"
                >
                    <l:content>
                        <Label text="Employee ID" />
                        <Input />
                        <Label text="Employee Name" />
                        <Input />
                        <Label text="Employee Designation" />
                        <Input />
                        <Label text="Office Name" />
                        <Input />
                        <Label text="Office EmailId" />
                        <Input />
                        <Label text="Office Phone no." />
                        <Input />
                    </l:content>
                </l:Grid>
            </Panel>
            <Panel
                headerText="ZigZag Pattern"
                expandable="true"
            >
                <l:Grid vSpacing="0">
                    <l:content>
                        <Label text="Employee ID" class="sapUiTinyMarginTop">
                            <layoutData>
                                <l:GridData span="L3 M3" />
                            </layoutData>
                        </Label>
                        <Input>
                            <layoutData>
                                <l:GridData span="L9 M9" />
                            </layoutData>
                        </Input>
                        <Label text="Employee Name" class="sapUiTinyMarginTop">
                            <layoutData>
                                <l:GridData span="L3 M3"/>
                            </layoutData>
                        </Label>
                        <Input>
                            <layoutData>
                                <l:GridData span="L3 M3" />
                            </layoutData>
                        </Input>
                        <Label text="Employee Designation" class="sapUiTinyMarginTop">
                            <layoutData>
                                <l:GridData span="L3 M3" />
                            </layoutData>
                        </Label>
                        <Input>
                            <layoutData>
                                <l:GridData span="L3 M3" />
                            </layoutData>
                        </Input>
                        <Label text="Office Name" class="sapUiTinyMarginTop">
                            <layoutData>
                                <l:GridData span="L2 M2" />
                            </layoutData>
                        </Label>
                        <Input>
                            <layoutData>
                                <l:GridData span="L2 M2" />
                            </layoutData>
                        </Input>
                        <Label text="Office EmailId" class="sapUiTinyMarginTop">
                            <layoutData>
                                <l:GridData span="L2 M2" />
                            </layoutData>
                        </Label>
                        <Input>
                            <layoutData>
                                <l:GridData span="L2 M2" />
                            </layoutData>
                        </Input>
                        <Label text="Office Phone no." class="sapUiTinyMarginTop">
                            <layoutData>
                                <l:GridData span="L2 M2" />
                            </layoutData>
                        </Label>
                        <Input>
                            <layoutData>
                                <l:GridData span="L2 M2"/>
                            </layoutData>
                        </Input>
                    </l:content>
                </l:Grid>
            </Panel>
        </content>
    </Page>
</mvc:View>
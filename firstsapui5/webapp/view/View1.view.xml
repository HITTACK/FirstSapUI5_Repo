<mvc:View controllerName="com.demo.firstsapui5.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="This is View1">
        <content>
            
            <Label text="Enter your name" required="true" class="sapUiTinyMarginTop"></Label>
            <Input width="30%" class="sapUiSmallMarginBegin" placeholder="Name"></Input>
            
        </content>
        <footer>
            <Bar >
                <contentRight>
                    <Button id="Button1" text = "Go to Second View" press="onPress" type="Emphasized"></Button>
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>